# /etc/nginx/conf.d/sky-passport.conf — generated from deploy/nginx.conf.template (DOMAIN, CERT, KEY filled in by setup)
limit_req_zone $binary_remote_addr zone=skyapi:10m rate=30r/m;
limit_req_zone $binary_remote_addr zone=skyev:10m rate=120r/m;
server {
  listen 80;
  server_name __DOMAIN__;
  location /.well-known/acme-challenge/ { root /srv/sky-passport/acme; }
  location / { return 301 https://$host$request_uri; }
}
server {
  listen 443 ssl http2;
  server_name __DOMAIN__;
  ssl_certificate     __CERT__;
  ssl_certificate_key __KEY__;
  ssl_protocols TLSv1.2 TLSv1.3;

  root /srv/sky-passport/public;
  index index.html;
  charset utf-8;
  gzip on; gzip_types text/css application/javascript application/json image/svg+xml; gzip_min_length 1024;

  # page + scripts: always revalidate so a deploy shows up at once
  location = /index.html { add_header Cache-Control "no-cache"; }
  location /js/ { add_header Cache-Control "no-cache"; }
  # heavy static files live in the bucket (server/cos_sync.js keeps it in step; deploy/COS.md); remove these two blocks when COS is not used
  location ~ "^/(fonts|vendor|sfx|mp|promo)/" { return 302 https://sky-passport-1252289725.cos.ap-beijing.myqcloud.com/static$request_uri; }
  # data: bucket too (its domain is in the mini program's request list since 2026-10-11)
  location ~ "^/(airports|china|world-50m)\.json$" { return 302 https://sky-passport-1252289725.cos.ap-beijing.myqcloud.com/static$request_uri; }
  # data, fonts, flags, vendored libraries: cache for a week
  location ~* \.(json|woff2|svg|js)$ { add_header Cache-Control "public, max-age=604800"; }

  # rendered videos (24 h), streamable while downloading
  location /v/ { alias /srv/sky-passport/videos/; types { video/mp4 mp4; } add_header Cache-Control "public, max-age=86400"; }
  location /api/video {
    proxy_pass http://127.0.0.1:3102;
    proxy_set_header X-Forwarded-For $remote_addr;
    client_max_body_size 700k;
  }
  # screenshot import: one picture per request (base64), recognised by Tencent Cloud OCR in server/shots.js; uploads from slow lines need time
  location = /api/shots {
    proxy_pass http://127.0.0.1:3100;
    proxy_set_header Host $host;
    proxy_set_header X-Forwarded-For $remote_addr;
    client_max_body_size 6m; client_body_timeout 150s; proxy_read_timeout 40s;
    limit_req zone=skyapi burst=20 nodelay;
  }
  # anonymous usage counts (server/ev.js): tiny bodies, their own rate limit so they never eat into /api/shots or /api/check
  location = /api/ev {
    proxy_pass http://127.0.0.1:3100;
    proxy_set_header X-Forwarded-For $remote_addr;
    proxy_set_header User-Agent $http_user_agent;
    client_max_body_size 4k;
    limit_req zone=skyev burst=40 nodelay;
  }
  location /api/ {
    proxy_pass http://127.0.0.1:3100;
    proxy_set_header Host $host;
    proxy_set_header X-Forwarded-For $remote_addr;
    client_max_body_size 256k;
    limit_req zone=skyapi burst=10 nodelay;
  }
}
# internal copy of the site for the headless renderer (never exposed publicly)
server {
  listen 127.0.0.1:8088;
  root /srv/sky-passport/public;
  index index.html;
  charset utf-8;
  location / { try_files $uri =404; }
}
