.wrap { padding: 24rpx 32rpx 80rpx; }
.hero { display: flex; flex-direction: column; padding: 24rpx 0 32rpx; border-bottom: 1px solid rgba(227,189,132,.22); margin-bottom: 28rpx; }
.eyebrow { font-family: monospace; font-size: 22rpx; letter-spacing: 6rpx; color: #b88f55; }
.title { font-size: 72rpx; font-weight: 900; color: #e3bd84; letter-spacing: 8rpx; margin: 8rpx 0 12rpx; font-family: serif; }
.lede { color: #c3a99f; font-size: 26rpx; }
.card { border: 1px solid rgba(227,189,132,.22); border-radius: 24rpx; padding: 28rpx; margin-bottom: 28rpx; background: rgba(255,255,255,.03); }
.h2 { font-size: 32rpx; font-weight: 700; margin-bottom: 20rpx; display: flex; align-items: baseline; gap: 16rpx; }
.h2 .no { font-family: monospace; font-size: 22rpx; color: #b88f55; letter-spacing: 4rpx; }
.h2 .link { margin-left: auto; font-size: 24rpx; color: #e3bd84; font-weight: 400; }
.h3 { font-size: 28rpx; font-weight: 700; margin: 28rpx 0 12rpx; }
button.primary { background: linear-gradient(180deg,#e9c58e,#b98a50); color: #2a0b12; font-weight: 700; border-radius: 20rpx; margin: 16rpx 0; font-size: 30rpx; }
button.ghost { background: transparent; color: #e3bd84; border: 1px solid #b88f55; border-radius: 20rpx; margin: 16rpx 0; font-size: 28rpx; }
button[disabled] { opacity: .5; }
.guide { color: #e3bd84; font-size: 26rpx; margin-top: 12rpx; }
.steps { margin-top: 12rpx; }
.step { display: flex; gap: 16rpx; padding: 12rpx 0; border-top: 1px dashed rgba(227,189,132,.22); font-size: 26rpx; }
.step .n { width: 40rpx; height: 40rpx; border-radius: 50%; background: #b98a50; color: #2a0b12; text-align: center; line-height: 40rpx; font-weight: 700; flex-shrink: 0; }
.small { color: #c3a99f; font-size: 24rpx; }
.center { display: block; text-align: center; }
.chips { display: flex; flex-wrap: wrap; gap: 12rpx; margin-bottom: 16rpx; }
.chip { padding: 8rpx 22rpx; border-radius: 999rpx; border: 1px solid rgba(227,189,132,.35); font-size: 24rpx; color: #e3bd84; }
.chip.on { background: linear-gradient(180deg,#e9c58e,#b98a50); color: #2a0b12; border-color: #f3d7a6; }
.row { display: flex; align-items: center; gap: 12rpx; }
.warn { margin-top: 16rpx; padding: 16rpx 20rpx; border: 1px solid #f0b35a; border-radius: 16rpx; color: #f0b35a; font-size: 24rpx; display: flex; flex-direction: column; gap: 6rpx; }
.stats { display: grid; grid-template-columns: repeat(3, 1fr); gap: 14rpx; }
.st { background: rgba(227,189,132,.06); border: 1px solid rgba(227,189,132,.18); border-radius: 16rpx; padding: 14rpx 16rpx; display: flex; flex-direction: column; }
.st .k { font-size: 22rpx; color: #c3a99f; }
.st .v { font-size: 38rpx; font-weight: 700; color: #f4e9df; }
.badges { display: grid; grid-template-columns: repeat(2, 1fr); gap: 14rpx; }
.badge { border: 1px solid rgba(227,189,132,.22); border-radius: 16rpx; padding: 14rpx 16rpx; display: flex; flex-direction: column; background: rgba(227,189,132,.05); }
.badge .k { font-size: 22rpx; color: #c3a99f; }
.badge .v { font-size: 28rpx; font-weight: 700; color: #e3bd84; word-break: break-all; }
.badge .d { font-size: 22rpx; color: #c3a99f; word-break: break-all; }
.input { background: #1d070c; border: 1px solid rgba(227,189,132,.22); border-radius: 16rpx; padding: 18rpx 20rpx; color: #f4e9df; font-size: 28rpx; height: 44rpx; }
.poster { width: 100%; border-radius: 16rpx; margin-top: 16rpx; border: 1px solid rgba(227,189,132,.22); }
.busy { position: fixed; left: 32rpx; right: 32rpx; bottom: 40rpx; padding: 20rpx; border-radius: 16rpx; background: rgba(0,0,0,.75); color: #fff; text-align: center; font-size: 26rpx; }
.err { margin: 16rpx 0; padding: 16rpx 20rpx; border-radius: 16rpx; border: 1px solid #ff8a9a; color: #ff9aa8; font-size: 24rpx; }
.foot { display: block; margin-top: 24rpx; font-size: 20rpx; color: rgba(195,169,159,.6); text-align: center; }
.offscreen { position: fixed; left: -10000px; top: 0; }
