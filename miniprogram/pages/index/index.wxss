.page { padding-bottom: 60rpx; }
.hero { padding: 40rpx 32rpx 10rpx; display: flex; flex-direction: column; }
.kicker { font-family: monospace; font-size: 20rpx; letter-spacing: 5rpx; color: #5eeaff; display: flex; align-items: center; gap: 14rpx; margin-bottom: 22rpx; }
.live { width: 14rpx; height: 14rpx; border-radius: 50%; background: #6ff7c8; animation: blink 1.6s steps(2) infinite; }
@keyframes blink { 50% { opacity: .25; } }
.big { font-size: 84rpx; font-weight: 800; line-height: 1.1; color: #fff; }
.big .g { color: #e9c58e; } .big .c { color: #5eeaff; }
.verse { margin-top: 34rpx; padding-left: 26rpx; border-left: 3rpx solid #e9c58e; font-family: serif; font-size: 36rpx; line-height: 1.7; letter-spacing: 3rpx; color: #cfdcec; }
.verse .vg { color: #e9c58e; }
.lede { margin: 16rpx 0 34rpx; font-size: 26rpx; color: #8fa6c2; }
.cta { width: 100% !important; background: linear-gradient(180deg,#f6d7a2,#c69652); color: #1a0d04; font-weight: 700; font-size: 32rpx; border-radius: 22rpx; margin: 0; padding: 14rpx 0; box-shadow: 0 16rpx 44rpx rgba(233,197,142,.22); }
.cta2 { display: flex; gap: 20rpx; margin-top: 20rpx; }
.cta2 .ghost { flex: 1; width: auto !important; background: rgba(94,234,255,.06); color: #5eeaff; border: 1px solid rgba(94,234,255,.5); border-radius: 22rpx; font-size: 26rpx; padding: 8rpx 0; margin: 0; }
.demo { width: 100%; height: 1190rpx; margin-top: 24rpx; border-radius: 24rpx; }
.trust { display: flex; flex-wrap: wrap; gap: 8rpx 28rpx; margin-top: 30rpx; font-family: monospace; font-size: 21rpx; color: #8fa6c2; }
.stage { padding: 0 32rpx; }
.globe { position: relative; width: 686rpx; height: 686rpx; margin: 10rpx auto 0; overflow: hidden; }
.gimg { position: absolute; left: 0; top: 0; width: 100%; height: 100%; }
.ring { position: absolute; left: 4%; top: 4%; right: 4%; bottom: 4%; border-radius: 50%; border: 1px dashed rgba(94,234,255,.25); animation: spin 60s linear infinite; }
.ring.r2 { left: 1%; top: 1%; right: 1%; bottom: 1%; border: 1px solid transparent; border-top-color: rgba(94,234,255,.6); border-right-color: rgba(94,234,255,.15); animation: spin 9s linear infinite reverse; }
@keyframes spin { to { transform: rotate(360deg); } }
.ghud { position: absolute; top: 4%; font-family: monospace; font-size: 19rpx; letter-spacing: 3rpx; color: #5eeaff; line-height: 1.5; }
.ghud.tl { left: 2%; } .ghud.tr { right: 2%; text-align: right; } .ghud .b { color: #eaf4ff; font-weight: 700; } .ghud .dot { color: #ff4f9a; }
.board { margin-top: 12rpx; border-radius: 28rpx; padding: 28rpx; background: linear-gradient(180deg, rgba(10,24,56,.9), rgba(4,10,26,.94)); border: 1px solid rgba(94,234,255,.18); }
.who { display: flex; justify-content: space-between; align-items: center; font-family: monospace; font-size: 22rpx; letter-spacing: 3rpx; color: #5eeaff; margin-bottom: 20rpx; }
.who .b { color: #eaf4ff; font-weight: 700; } .who .tag { font-size: 19rpx; padding: 2rpx 14rpx; border-radius: 999rpx; border: 1px solid #ff4f9a; color: #ff4f9a; }
.bstats { display: grid; grid-template-columns: 1fr 1fr; gap: 22rpx 20rpx; }
.flaps { display: flex; gap: 4rpx; }
.fl { font-family: monospace; font-weight: 700; font-size: 40rpx; line-height: 62rpx; width: 38rpx; text-align: center; color: #fff6e2; border-radius: 6rpx; background: linear-gradient(180deg, #14284f 0, #14284f 49%, #050c1e 49%, #050c1e 51%, #0c1a38 51%, #0c1a38 100%); }
.sep { font-family: monospace; font-weight: 700; font-size: 40rpx; line-height: 62rpx; color: #fff6e2; }
.bl { display: block; margin-top: 8rpx; font-size: 22rpx; color: #8fa6c2; }
.bline { display: block; margin-top: 22rpx; padding-top: 18rpx; border-top: 1px dashed rgba(94,234,255,.18); font-family: monospace; font-size: 23rpx; color: #8fa6c2; }
.bnote { display: block; margin-top: 10rpx; font-size: 22rpx; color: #8fa6c2; }
.ticker { margin-top: 36rpx; padding: 18rpx 0; border-top: 1px solid rgba(94,234,255,.16); border-bottom: 1px solid rgba(94,234,255,.16); overflow: hidden; white-space: nowrap; background: rgba(8,18,40,.6); }
.track { display: inline-block; white-space: nowrap; animation: tick 46s linear infinite; }
@keyframes tick { to { transform: translateX(-50%); } }
.tk { display: inline-block; padding: 0 36rpx; font-family: monospace; font-size: 23rpx; letter-spacing: 2rpx; color: #eaf4ff; border-right: 1px solid rgba(94,234,255,.16); }
.tk .fn { color: #e9c58e; font-weight: 700; } .tk .pl { color: #5eeaff; } .tk .ok { font-size: 19rpx; color: #6ff7c8; border: 1px solid #6ff7c8; border-radius: 6rpx; padding: 0 10rpx; margin-left: 10rpx; }
.how { margin: 36rpx 32rpx 0; display: flex; flex-direction: column; gap: 16rpx; }
.card { display: flex; align-items: center; gap: 24rpx; padding: 28rpx; border-radius: 24rpx; border: 1px solid rgba(94,234,255,.16); background: linear-gradient(170deg, rgba(14,30,64,.7), rgba(5,12,30,.8)); }
.card .n { font-family: monospace; font-weight: 700; font-size: 52rpx; color: rgba(94,234,255,.55); }
.ht { font-size: 30rpx; font-weight: 700; } .hd { font-size: 23rpx; color: #8fa6c2; }
.sec { margin: 36rpx 32rpx 0; padding: 28rpx; border: 1px solid rgba(94,234,255,.16); border-radius: 28rpx; background: rgba(8,18,40,.82); }
.sec-h { font-size: 30rpx; font-weight: 800; display: flex; align-items: baseline; gap: 16rpx; }
.sec-h .arrow { margin-left: auto; color: #5eeaff; }
.sec .step:first-of-type { margin-top: 16rpx; }
.sec-h .code { font-family: monospace; font-size: 20rpx; font-weight: 700; color: #02040b; background: #5eeaff; border-radius: 8rpx; padding: 2rpx 12rpx; letter-spacing: 2rpx; }
.shots { width: 630rpx; height: 800rpx; margin: 0 auto; }
.shot { margin: 0 12rpx; height: 740rpx; border-radius: 26rpx; overflow: hidden; position: relative; border: 1px solid rgba(94,234,255,.3); }
.shot image { width: 100%; height: 100%; }
.cap { position: absolute; left: 0; right: 0; bottom: 0; padding: 18rpx 24rpx; font-size: 24rpx; color: #eaf4ff; background: linear-gradient(transparent, rgba(2,4,11,.88)); }
.step { display: flex; gap: 18rpx; padding: 14rpx 0; border-top: 1px dashed rgba(94,234,255,.18); font-size: 26rpx; }
.step:first-of-type { border-top: 0; }
.sn { width: 44rpx; height: 44rpx; line-height: 44rpx; border-radius: 50%; background: #5eeaff; color: #02040b; text-align: center; font-weight: 700; flex-shrink: 0; font-family: monospace; }
.small { font-size: 23rpx; color: #8fa6c2; margin-top: 4rpx; }
.more { font-size: 24rpx; color: #5eeaff; text-align: center; margin-top: 12rpx; }
.long { width: 100%; border-radius: 18rpx; border: 1px solid rgba(94,234,255,.2); margin: 16rpx 0 24rpx; }
.foot { display: block; margin: 36rpx 32rpx 0; font-size: 20rpx; color: rgba(143,166,194,.7); text-align: center; white-space: pre-line; }
.busy { position: fixed; left: 32rpx; right: 32rpx; bottom: 40rpx; padding: 22rpx; border-radius: 16rpx; background: rgba(0,0,0,.85); border: 1px solid rgba(94,234,255,.3); color: #fff; text-align: center; font-size: 26rpx; }
.err { margin: 24rpx 32rpx 0; padding: 18rpx 22rpx; border-radius: 16rpx; border: 1px solid #ff7a93; color: #ff9aa8; font-size: 24rpx; }
.more2 { margin-top: 22rpx; font-size: 24rpx; color: #5eeaff; text-align: center; }
.ghost.wide { width: 100% !important; background: rgba(94,234,255,.06); color: #5eeaff; border: 1px solid rgba(94,234,255,.5); border-radius: 22rpx; font-size: 26rpx; padding: 8rpx 0; margin: 20rpx 0 0; }
.notice { margin-top: 20rpx; text-align: center; font-size: 24rpx; color: #d9ccb3; }
.nu { color: #5eeaff; }
.gnote { margin-top: 18rpx; padding: 20rpx 24rpx; border: 1px solid rgba(233,197,142,.4); border-radius: 18rpx; background: rgba(233,197,142,.06); font-size: 24rpx; line-height: 1.7; color: #e8ddc8; }
.gsub { margin-top: 22rpx; font-size: 24rpx; color: #8fa6c2; }
.ways-h { margin-top: 6rpx; font-size: 26rpx; font-weight: 700; color: #e9c58e; letter-spacing: 2rpx; }
.way { display: flex; align-items: center; gap: 20rpx; margin-top: 16rpx; padding: 22rpx 24rpx; border-radius: 22rpx; border: 1px solid rgba(94,234,255,.22); background: rgba(8,18,40,.82); }
.way.rec { border-color: #e9c58e; background: linear-gradient(180deg, rgba(233,197,142,.16), rgba(233,197,142,.05)); }
.wn { flex: none; width: 48rpx; height: 48rpx; line-height: 48rpx; text-align: center; border-radius: 50%; font-family: monospace; font-weight: 700; font-size: 26rpx; color: #02040b; background: #5eeaff; }
.way.rec .wn { background: #e9c58e; }
.wb { flex: 1; min-width: 0; } .wt { font-size: 30rpx; font-weight: 800; color: #eaf4ff; } .wd { margin-top: 4rpx; font-size: 23rpx; line-height: 1.55; color: #8fa6c2; }
.wtag { margin-left: 14rpx; font-size: 20rpx; font-weight: 700; color: #1a0d04; background: #e9c58e; border-radius: 8rpx; padding: 2rpx 12rpx; vertical-align: 4rpx; }
.wlink { margin-top: 8rpx; font-size: 23rpx; color: #5eeaff; padding: 4rpx 0; }
.wa { flex: none; font-size: 40rpx; color: #5eeaff; } .way.rec .wa { color: #e9c58e; }
.flow { display: flex; flex-wrap: wrap; align-items: center; justify-content: center; gap: 6rpx 12rpx; margin-top: 26rpx; font-size: 22rpx; color: #8fa6c2; }
.fn { color: #5eeaff; margin-right: 4rpx; } .fa { color: rgba(94,234,255,.5); }
