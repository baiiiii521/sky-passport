<view class="page">
  <!-- hero: the line, the globe, the sample numbers -->
  <view class="hero">
    <view class="kicker"><view class="live"></view>FLIGHT LOG ONLINE · 解码你的天空</view>
    <view class="big">每一次起飞</view>
    <view class="big"><text class="g">都值得被</text><text class="c">记住</text></view>
    <text class="verse">登机牌会褪色，\n<text class="vg">飞过的天空不会。</text></text>
    <text class="lede">一分钟，把航班记录变成一本会动的护照。</text>
    <button class="cta" bindtap="chooseFile">开始制作 · 从聊天中选择表格</button>
    <view class="cta2">
      <button class="ghost" bindtap="tryDemo">先用示例数据体验</button>
      <button class="ghost" bindtap="playDemo">▶ 看示例视频</button>
    </view>
    <video wx:if="{{showDemo}}" class="demo" src="{{demoVideo}}" poster="{{demoPoster}}" autoplay controls object-fit="contain" show-fullscreen-btn></video>
    <view class="trust"><text>◆ 表格在手机上解析</text><text>◆ 免费</text><text>◆ 1080×1920 视频 + 原创配乐</text></view>
  </view>

  <view class="stage">
    <view class="globe">
      <view class="ring"></view><view class="ring r2"></view>
      <image class="gimg" src="{{globeImg}}" mode="aspectFit"/>
      <text class="ghud tl"><text class="dot">●</text> 实时航迹\n<text class="b">33</text> 条航线</text>
      <text class="ghud tr">ORBIT · 01\n<text class="b">29.2°N 110.1°E</text></text>
    </view>
    <view class="board">
      <view class="who"><text>示例旅客 · <text class="b">林小舟</text></text><text class="tag">虚构示例</text></view>
      <view class="bstats">
        <view wx:for="{{sample}}" wx:key="l" class="bs"><view class="flaps"><text wx:for="{{item.c}}" wx:for-item="ch" wx:key="index" class="{{ch===','?'sep':'fl'}}">{{ch}}</text></view><text class="bl">{{item.l}}</text></view>
      </view>
      <text class="bline">绕地球 3.28 圈 · 2018 — 2023</text>
      <text class="bnote">这是示例。选择你的表格后，会换成你的数字、成就和长图。</text>
    </view>
  </view>

  <view class="ticker"><view class="track"><text wx:for="{{ticker}}" wx:key="index" class="tk"><text class="fn">{{item[0]}}</text> {{item[1]}} <text class="pl">✈</text> {{item[2]}} <text class="ok">已到达</text></text></view></view>

  <view class="how">
    <view wx:for="{{how}}" wx:key="t" class="card"><text class="n">0{{index+1}}</text><view><view class="ht">{{item.t}}</view><view class="hd">{{item.d}}</view></view></view>
  </view>

  <view class="sec">
    <view class="sec-h"><text class="code">FILM</text>成片预览</view>
    <swiper class="shots" autoplay interval="3200" circular previous-margin="110rpx" next-margin="110rpx" indicator-dots indicator-color="rgba(94,234,255,.25)" indicator-active-color="#5eeaff">
      <swiper-item wx:for="{{shots}}" wx:key="src">
        <view class="shot" data-src="{{item.src}}" bindtap="previewShot"><image src="{{item.src}}" mode="aspectFill" lazy-load/><text class="cap">{{item.cap}}</text></view>
      </swiper-item>
    </swiper>
  </view>

  <view class="sec">
    <view class="sec-h"><text class="code">GUIDE</text>三步做好</view>
    <view wx:for="{{guide}}" wx:key="index" class="step"><text class="sn">{{index+1}}</text><view class="st"><view>{{item[0]}}</view><view wx:if="{{guideOpen}}" class="small">{{item[1]}}</view></view></view>
    <view class="more" bindtap="toggleGuide">{{guideOpen?'收起说明 ▴':'看详细说明 ▾'}}</view>
  </view>

  <view class="sec">
    <view class="sec-h"><text class="code">POSTER</text>长图海报 · 33 枚飞行勋章</view>
    <text class="small">勋章由航班自动算出，点选喜欢的印到长图上。</text>
    <image class="long" src="{{longImg}}" mode="widthFix" lazy-load data-src="{{longImg}}" bindtap="previewShot"/>
    <button class="cta" bindtap="chooseFile">做一张我自己的</button>
  </view>

  <text class="foot">表格只在你的手机上解析；生成视频时才把航段发到我们的服务器渲染，24 小时后自动删除。\n地图数据 Natural Earth、DataV.GeoAtlas · 机场数据 OpenFlights（ODbL）</text>
  <view wx:if="{{busy}}" class="busy">{{busy}}</view>
  <view wx:if="{{err}}" class="err">{{err}}</view>
</view>
