<view class="wrap">
  <view class="card empty" wx:if="{{!has}}">
    <view class="h2"><text class="no">01</text>导入你的航班</view>
    <text class="small">从微信聊天里选中航旅纵横导出的表格（.xls / .xlsx / .csv），在手机上解析，不上传。</text>
    <button class="primary" bindtap="chooseFile">从聊天中选择表格</button>
    <button wx:if="{{!manualOpen}}" class="ghost" bindtap="pickShots">没有表格？上传行程截图</button>
    <button wx:if="{{!manualOpen}}" class="ghost" bindtap="openManual">{{saved?'继续手动输入（已有 '+saved+' 段）':'或者手动输入航班'}}</button>
    <button class="ghost" bindtap="tryDemo">先用示例数据体验</button>
  </view>

  <view class="card" wx:if="{{manualOpen}}">
    <view class="h2"><text class="no">+</text>截图识别 · 手动输入<text class="tag" bindtap="closeManual">完成 ✓</text></view>
    <button class="ghost shotbtn" bindtap="pickShots">从行程截图识别（可选多张）</button>
    <text class="small center">航旅纵横「行程 → 已结束」的截图即可；会上传到我们的服务器识别文字，识别完即丢弃</text>
    <text wx:if="{{shotMsg}}" class="mhint ok">{{shotMsg}}</text>
    <view wx:if="{{shotTodo.length}}" class="todo"><text wx:for="{{shotTodo}}" wx:key="index" class="tl">· {{item}}</text></view>
    <view class="or"><text>或者一段一段手动输入</text></view>
    <picker mode="date" value="{{mDate}}" start="1950-01-01" end="2099-12-31" bindchange="onMDate"><view class="input pick {{mDate?'':'ph'}}">{{mDate||'日期（点这里选择）'}}</view></picker>
    <view class="mrow">
      <input class="input" placeholder="出发 如 PVG / 上海浦东" value="{{mFrom}}" bindinput="onMFrom" maxlength="30"/>
      <input class="input" placeholder="到达 如 NRT / 东京成田" value="{{mTo}}" bindinput="onMTo" maxlength="30"/>
    </view>
    <input class="input" placeholder="航班号（可不填）如 MU523" value="{{mFn}}" bindinput="onMFn" maxlength="10"/>
    <text wx:if="{{mHint}}" class="mhint {{mCls}}">{{mHint}}</text>
    <button class="primary" bindtap="addLeg">添加这一段</button>
    <view wx:if="{{legs.length}}" class="legs">
      <view class="legh"><text>已输入 {{legs.length}} 段 · 保存在这台手机上</text><text class="legclr" bindtap="clearLegs">清空</text></view>
      <view wx:for="{{legs}}" wx:key="i" class="leg"><text class="ld">{{item.d}}</text><text class="lt">{{item.t}}{{item.fn?' · '+item.fn:''}}</text><text class="lx" data-i="{{item.i}}" bindtap="delLeg">✕</text></view>
    </view>
    <text wx:else class="small center">机场可以写三字码、中文名或英文名；输完一段，出发地会自动接上一段的到达地。</text>
  </view>
  <view class="card" wx:if="{{has}}">
    <view class="h2"><text class="no">01</text>{{demo?'示例数据 · 虚构旅客':'你的航班记录'}}</view>
    <view class="chips">
      <view class="chip {{year===0?'on':''}}" data-y="0" bindtap="pickYear">全部年份</view>
      <view wx:for="{{years}}" wx:key="*this" class="chip {{year===item?'on':''}}" data-y="{{item}}" bindtap="pickYear">{{item}} 年度</view>
    </view>
    <view class="chips"><view class="chip" bindtap="chooseFile">换一份表格</view><view wx:if="{{!manualOpen}}" class="chip" bindtap="openManual">＋ 截图识别 / 手动添加</view></view>
    <view class="row"><switch checked="{{up}}" bindchange="toggleUp" color="#5eeaff"/><text class="small">计入待出行航班</text></view>
    <view wx:if="{{unres.length||noDate}}" class="warn">
      <text wx:if="{{unres.length}}">有 {{unres.length}} 个地名没认出来（{{unres[0]}}{{unres.length>1?' 等':''}}），这些航段没有算进去。</text>
      <text wx:if="{{noDate}}">{{noDate}} 行没有日期，已跳过。</text>
      <text>到网页版可以逐条补全，修正后的表格也能下载。</text>
    </view>
    <view wx:if="{{sum && sum.n}}" class="stats">
      <view class="st"><text class="k">航班</text><text class="v">{{sum.n}}</text></view>
      <view class="st"><text class="k">里程 km</text><text class="v">{{sum.kmText}}</text></view>
      <view class="st"><text class="k">飞行小时</text><text class="v">{{sum.hours}}</text></view>
      <view class="st"><text class="k">国家地区</text><text class="v">{{sum.cc}}</text></view>
      <view class="st"><text class="k">机场</text><text class="v">{{sum.ap}}</text></view>
      <view class="st"><text class="k">航司</text><text class="v">{{sum.al}}</text></view>
    </view>
    <text wx:else class="small">这个范围里没有可用的航班，换个年份试试。</text>
  </view>

  <view class="card" wx:if="{{has && sum && sum.n}}">
    <view class="h2"><text class="no">02</text>飞行护照视频<text class="tag">{{label}}</text></view>
    <view class="fields">
      <input class="input" placeholder="名字（显示在护照上，可不填）" value="{{name}}" bindinput="onName" maxlength="16"/>
      <input class="input" placeholder="拼音 / 英文名（机读码，可不填）" value="{{latin}}" bindinput="onLatin" maxlength="24"/>
    </view>
    <view class="opt"><text class="ol">封皮</text>
      <view wx:for="{{themes}}" wx:key="v" class="sw {{theme===item.v?'on':''}}" data-k="theme" data-v="{{item.v}}" bindtap="pick"><view class="dot" style="background:{{item.c}}"></view>{{item.t}}</view>
    </view>
    <view class="opt"><text class="ol">配乐</text>
      <view class="sw {{mstyle==='groove'?'on':''}}" data-k="mstyle" data-v="groove" bindtap="pick">律动</view>
      <view class="sw {{mstyle==='calm'?'on':''}}" data-k="mstyle" data-v="calm" bindtap="pick">舒缓</view>
    </view>
    <view class="opt"><text class="ol">片长</text>
      <view wx:for="{{lens}}" wx:key="v" class="sw {{len===item.v?'on':''}}" data-k="len" data-v="{{item.v}}" bindtap="pick">{{item.t}}</view>
    </view>

    <button wx:if="{{video.state!=='done'}}" class="primary" bindtap="makeVideo" disabled="{{video.state==='queued'||video.state==='rendering'||video.state==='sending'}}">
      {{video.state==='sending'?'正在提交…':video.state==='queued'?(video.ahead?'排队中，前面还有 '+video.ahead+' 个':'马上开始…'):video.state==='rendering'?'正在生成 '+video.progress+'%':'生成视频'}}
    </button>
    <text wx:if="{{!video.state}}" class="small center">在服务器上生成，约 40 秒；会上传航段（日期、航班号、出发/到达地）和名字，24 小时后自动删除</text>
    <view wx:if="{{video.state==='rendering'||video.state==='queued'}}" class="bar"><view class="fill" style="width:{{video.progress}}%"></view></view>
    <text wx:if="{{video.state==='rendering'||video.state==='queued'}}" class="small center">通常 40 秒左右，可以先去生成下面的长图</text>
    <text wx:if="{{video.state==='error'}}" class="errline">{{video.err}}</text>
    <view wx:if="{{video.state!=='done'}}" class="webtip" bindtap="copySite">
      <text class="small">速度慢或生成失败？用手机浏览器打开网页版，在本机直接生成：</text>
      <text class="weburl">passport.nybbq.art</text><text class="small"> · 点这里复制网址</text>
    </view>

    <block wx:if="{{video.state==='done'}}">
      <video class="player" src="{{video.url}}" controls autoplay object-fit="contain" show-fullscreen-btn></video>
      <view class="two">
        <button class="primary" bindtap="saveVideo" disabled="{{!!saving}}">{{saving||'存到相册'}}</button>
        <button class="primary" bindtap="sendVideo" disabled="{{!!saving}}">发给朋友</button>
      </view>
      <text class="small center">视频 {{video.size}} · 发朋友圈请先存到相册，再在朋友圈选择这段视频</text>
      <button class="ghost" bindtap="makeVideo" data-again="1">换个风格重新生成</button>
    </block>
  </view>

  <view class="card next" wx:if="{{has && sum && sum.n}}" bindtap="toBadges">
    <view><view class="nt">飞行成就 · 长图海报</view><view class="small">{{demo?'示例':'你'}}的 33 枚勋章已经算好，选几枚印上长图</view></view><text class="na">→</text>
  </view>

  <view wx:if="{{busy}}" class="busy">{{busy}}</view>
  <view wx:if="{{err}}" class="err">{{err}}</view>
</view>
